# Runtime environment
PALVELUT_ENVIRONMENT=local
DJANGO_SECRET_KEY=replace-me-with-a-unique-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=https://example.invalid/palvelut
SYNTHETIC_MONITOR_TOKEN=replace-me-with-a-random-monitor-token
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# PostgreSQL
POSTGRES_DB=palvelut
POSTGRES_USER=palvelut
POSTGRES_PASSWORD=replace-me-with-a-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Valkey / Celery
VALKEY_URL=redis://valkey:6379/0
CELERY_BROKER_URL=redis://valkey:6379/1
CELERY_RESULT_BACKEND=redis://valkey:6379/2

# Email
# Local Docker Compose uses Mailpit without auth/TLS. Production must override
# these values with a real authenticated SMTP provider and deliverable sender.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=palvelut@example.invalid

# S3-compatible object storage
S3_ENDPOINT_URL=https://storage.example.invalid
S3_ACCESS_KEY_ID=replace-me-with-an-access-key-id
S3_SECRET_ACCESS_KEY=replace-me-with-a-secret-access-key
S3_BUCKET_NAME=replace-me-with-a-bucket-name
